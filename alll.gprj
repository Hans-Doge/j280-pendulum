<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<!-- 2026-10-28 22:35 更新：文件列表 = build.tcl 全部源码，新增 swing_up_energy.v（10-28 换入的老能量泵起摆，top.v SWING_SEL=1 路径） -->
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW2A-55C" pn="GW2A-LV55PG484C8/I7">gw2a55c-005</Device>
    <FileList>
        <File path="src/top.v" type="file.verilog" enable="1"/>
        <File path="src/adc.v" type="file.verilog" enable="1"/>
        <File path="src/encoder.v" type="file.verilog" enable="1"/>
        <File path="src/key_filter.v" type="file.verilog" enable="1"/>
        <File path="src/motor_ctrl.v" type="file.verilog" enable="1"/>
        <File path="src/pid.v" type="file.verilog" enable="1"/>
        <File path="src/swing_up.v" type="file.verilog" enable="1"/>
        <File path="src/swing_up_energy.v" type="file.verilog" enable="1"/>
        <File path="src/kick_swing.v" type="file.verilog" enable="1"/>
        <File path="src/motor_drive.v" type="file.verilog" enable="1"/>
        <File path="src/uart.v" type="file.verilog" enable="1"/>
        <File path="src/uart_tx.v" type="file.verilog" enable="1"/>
        <File path="src/vel_est.v" type="file.verilog" enable="1"/>
        <File path="src/vel_est_arm.v" type="file.verilog" enable="1"/>
        <File path="src/energy_swing.v" type="file.verilog" enable="1"/>
        <File path="src/keypad.v" type="file.verilog" enable="1"/>
        <File path="src/kb_input.v" type="file.verilog" enable="1"/>
        <File path="src/oled_ssd1306.v" type="file.verilog" enable="1"/>
        <File path="src/fo_rip_top.cst" type="file.cst" enable="1"/>
        <File path="src/j280.sdc" type="file.sdc" enable="1"/>
    </FileList>
</Project>
